# Django
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (individual vars — used if DATABASE_URL is not set)
DB_NAME=polla_futbolera
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Or use a full DATABASE_URL (takes precedence in development.py)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/polla_futbolera

# App settings
PREDICTION_DEADLINE_MINUTES=20
INVITATION_LINK_BASE_URL=http://localhost:8000

# Football API (football-data.org)
FOOTBALL_API_KEY=
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4

# Email (for production)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@polla-futbolera.com

# Production only
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
